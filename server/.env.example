# ClamAV
ENABLE_CLAMAV=true
CLAMAV_MODE=clamscan
CLAMSCAN_BINARY=clamscan
FRESHCLAM_BINARY=freshclam
CLAMAV_DATABASE_DIR=/opt/homebrew/var/lib/clamav
CLAMAV_DEFINITION_MAX_AGE_HOURS=72

# YARA
ENABLE_YARA=true
YARA_BINARY=yara
YARAC_BINARY=yarac
YARA_RULES_PATHS=/absolute/path/to/virovanta/server/yara-rules
YARA_RULES_RECURSIVE=true
YARA_AUTO_COMPILE=true
YARA_MAX_MATCHES=50
YARA_FAST_SCAN=true
